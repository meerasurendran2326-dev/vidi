# PostgreSQL connection string. Keep real values in .env.local or the deployment secret store.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Razorpay test-mode keys. The secret is server-only and must never use a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_TEST_MODE_SECRET"

# Optional amount in INR; default is 0 until shipping rates are configured.
ORDER_SHIPPING_AMOUNT="0.00"

# Inventory assigned when creating brand-new catalog rows from the seed. Defaults to 0 for safety.
SEED_DEFAULT_STOCK="0"

# Authentication secret for signing/hashing session tokens. Keep secret in server-only store.
AUTH_SECRET="your_random_32_character_secret_key_here"

# Admin dashboard access. Set to the email address of the store administrator.
# Any signed-in user whose email matches this will be granted admin access.
# Never expose this in client-side code.
ADMIN_EMAIL="admin@yourstore.com"
